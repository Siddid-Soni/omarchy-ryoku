{
  "bar": {
    "centerAnchor": "ryoku.clock",
    "id": "ryoku.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "ryoku.clock",
          "verticalFormat": "h\n—\nmm\nAP",
          "weekStartDay": "monday"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "left": [
        {
          "id": "ryoku.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "evindor.keystroke",
    "ryoku.background"
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.background"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "evindor.keystroke"
    },
    {
      "id": "ryoku.background"
    }
  ],
  "version": 1
}
